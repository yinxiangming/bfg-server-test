# BFG2 E2E Test Configuration
# Copy this file to .env and fill in your values.

# =============================================================================
# Core workspace tests (test_01 to test_18)
# =============================================================================

# BFG workspace server base URL
BASE_URL=http://localhost:8000

# Superuser credentials (used to bootstrap workspaces)
BFG2_E2E_SUPERUSER_EMAIL=admin@example.com
BFG2_E2E_SUPERUSER_PASSWORD=yourpassword

# Test user credentials
BFG2_E2E_ADMIN_EMAIL=admin@test.com
BFG2_E2E_CUSTOMER_PASSWORD=customerpass
BFG2_E2E_TEMP_PASSWORD=temppass123

# Optional: override email addresses for test users
# BFG2_E2E_CUSTOMER_EMAIL=customer_e2e@test.com
# BFG2_E2E_CUSTOMER2_EMAIL=customer2_e2e@test.com
# BFG2_E2E_ADMIN2_EMAIL=admin2_e2e@test.com

# =============================================================================
# Platform extension — Embedded mode (e2e/bfg_platform/embedded/)
# =============================================================================
# Same server as above (BASE_URL). Just need the management workspace slug.

BFG2_E2E_PLATFORM_WORKSPACE_SLUG=admin

# =============================================================================
# Platform extension — Standalone mode (e2e/bfg_platform/standalone/)
# =============================================================================
# Requires a separate platform server. Set BASE_URL=http://localhost:8011 when running.

# Workspace server URL (for cross-server token exchange validation)
WORKSPACE_BASE_URL=http://localhost:8000

# Platform server credentials (separate from workspace server)
BFG2_E2E_PLATFORM_EMAIL=admin@platform.example.com
BFG2_E2E_PLATFORM_PASSWORD=yourpassword

# Shared API key between platform and workspace servers
BFG2_E2E_PLATFORM_API_KEY=your-shared-api-key
