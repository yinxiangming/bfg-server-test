# BFG2 HTTP API integration test configuration (env names keep BFG2_E2E_* for compatibility)
# Copy this file to .env and fill in your values.

# =============================================================================
# Core workspace tests — api/bfg_workspace/ (test_01 to test_18, etc.)
# =============================================================================

# BFG workspace server base URL
BASE_URL=http://localhost:8000

# Required for mutating API integration tests. Prefer the disposable runner,
# which creates these paths and values automatically.
# BFG2_E2E_DISPOSABLE=1
# BFG2_E2E_DATABASE_PATH=/tmp/bfg-server-e2e.example/db.sqlite3
# BFG2_E2E_DISPOSABLE_MARKER=/tmp/bfg-server-e2e.example/DISPOSABLE
# BFG2_E2E_SERVER_DIR=/path/to/bfg-server-django
# BFG2_E2E_SERVER_PYTHON=/path/to/python
# BFG2_E2E_SERVER_SCRATCH_MARKER=/path/to/bfg-server-django/.bfg-e2e-scratch
# BFG2_E2E_ATTESTATION_NONCE=runner-generated-random-value

# Optional for a production-mode server behind a local HTTP test connection.
# This makes requests emulate the TLS-terminating reverse proxy.
# BFG2_E2E_FORWARDED_PROTO=https

# Superuser credentials (used to bootstrap workspaces)
BFG2_E2E_SUPERUSER_EMAIL=admin@example.com
BFG2_E2E_SUPERUSER_PASSWORD=yourpassword

# Test user credentials
BFG2_E2E_ADMIN_EMAIL=admin@test.com
BFG2_E2E_CUSTOMER_PASSWORD=customerpass
BFG2_E2E_TEMP_PASSWORD=temppass123

# Optional: override email addresses for test users
# BFG2_E2E_CUSTOMER_EMAIL=customer_apitest@test.com
# BFG2_E2E_CUSTOMER2_EMAIL=customer2_apitest@test.com
# BFG2_E2E_ADMIN2_EMAIL=admin2_apitest@test.com

# =============================================================================
# Platform extension — Embedded mode (api/bfg_platform/embedded/)
# =============================================================================
# Same server as above (BASE_URL). Just need the management workspace slug.

BFG2_E2E_PLATFORM_WORKSPACE_SLUG=admin

# =============================================================================
# Platform extension — Standalone mode (api/bfg_platform/standalone/)
# =============================================================================
# Requires a separate platform server. Set BASE_URL=http://localhost:8011 when running.

# Workspace server URL (for cross-server token exchange validation)
WORKSPACE_BASE_URL=http://localhost:8000

# Platform server credentials (separate from workspace server)
BFG2_E2E_PLATFORM_EMAIL=admin@platform.example.com
BFG2_E2E_PLATFORM_PASSWORD=yourpassword

# Shared API key between platform and workspace servers
BFG2_E2E_PLATFORM_API_KEY=your-shared-api-key
